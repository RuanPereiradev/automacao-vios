# Albi — bot do Sonar (Leme Forense)
# Copie este arquivo para albi/.env (cp .env.example .env, dentro da pasta albi/) e preencha.
# O .env fica só neste computador: ele NUNCA vai para o git (está no .gitignore).
# Escreva cada valor logo depois do "=", sem espaço antes ou depois.

# --- Acesso ao Sonar ---
SONAR_URL=https://sonar.lemeforense.com.br/login

# CPF ou CNPJ do login. Pode ser só os números (12345678900) ou com pontuação
# (123.456.789-00); o Albi tira a pontuação antes de digitar.
SONAR_CPF_CNPJ=

# E-mail do login (o mesmo que você digita no Sonar).
SONAR_EMAIL=

# Senha do login. Normalmente sem aspas: SONAR_SENHA=Abc123#
# Se a senha tiver ESPAÇO, ou um # depois de espaço, ponha entre aspas simples:
#   SONAR_SENHA='minha senha #1'
# (sem as aspas, tudo depois de " #" seria tratado como comentário e a senha ficaria cortada).
# Se a senha tiver aspas simples ('), use aspas duplas: SONAR_SENHA="d'Avila123"
SONAR_SENHA=

# --- Campos da tela de login (só mude se a tela do Sonar mudar) ---
# Formato css:<seletor> ou xpath:<expressão>. Presos ao formulário #loginform porque a mesma
# página tem o formulário de "esqueci a senha" com campos de mesmo nome. Escritos com
# [id=...] e sem " #" porque, sem aspas, tudo depois de " #" vira comentário no .env.
LOGIN_CAMPO_CPF_CNPJ=css:#loginform input[id=input-cpf-cnpj]
LOGIN_CAMPO_EMAIL=css:#loginform input[id=loginform-username]
LOGIN_CAMPO_SENHA=css:#loginform input[id=loginform-password]
LOGIN_BOTAO=css:#loginform [id=btn-login]
# botão "Encerrar a outra sessão" da tela /login-conflito (vazio = o padrão do Albi)
CONFLITO_BOTAO=

# --- Pedidos ---
# Sacado (quem é cobrado) escolhido no passo 2; tem que ser um nome da lista do Sonar.
# Vazio = RONEELY FEITOSA & SOCIEDADE DE ADVOGADOS (o escritório).
SONAR_SACADO=
# Minutos esperando o Sonar terminar os pedidos antes de desistir (os que faltarem ficam
# "sem resultado"; dá para ver depois no Sonar). Vazio = 120.
SONAR_ESPERA_MIN=

# --- Execução ---
# Chrome do Sonar sempre sem janela (o Albi roda em segundo plano); este valor não muda isso
HEADLESS=true
# segundos de espera por cada elemento da tela
TIMEOUT=20

# --- DataJud (não é mais usado na mensagem da CAC; só no `datajud.py` manual) ---
DATAJUD=true
# Segundos, no total, para consultar todos os processos de uma execução. Vazio = 150.
DATAJUD_PRAZO=
# Chave pública da API (já vem no código). Só preencha se o CNJ trocar a chave na página da API pública.
DATAJUD_CHAVE=

# --- Presto (Oystr): entrar nos tribunais pelo Chrome já aberto no Mac (presto.py entrar) ---
# Senha/PIN que o quadro "Credenciais Disponíveis" do Presto pede depois de escolher a credencial.
# Fica só neste arquivo (fora do git); o bot nunca imprime nem salva o PIN.
PRESTO_PIN=
# Parte do nome da credencial a escolher no quadro (vazio = a primeira da lista).
PRESTO_CREDENCIAL=
# Login do console do Presto (https://console.presto.oystr.com.br/). O bot abre o tribunal pela
# página Sites do console, e é assim que a extensão entra com o login do Presto. Ficam só aqui.
PRESTO_EMAIL=
PRESTO_SENHA=

# --- Explicação de tipos de ação que não estão no dicionário fixo (Gemini, chave gratuita) ---
# Só o nome da classe ("Execução de alimentos") é enviado; nunca nome, CPF ou processo. Vazio = desligado.
GEMINI_API_KEY=
# Opcional. Vazio = gemini-flash-latest (e, se falhar, outros dois)
GEMINI_MODEL=
