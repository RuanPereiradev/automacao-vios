# Orelha — copie para orelha/.env e preencha (o orelha/.env não vai para o git).
# Seletores: "css:<seletor css>" ou "xpath:<expressão xpath>". Vazio = padrão indicado.
# O Orelha SÓ LÊ o VIOS: liga o bloqueio de envios já na tela de login (ORELHA_BLOQUEIO_NO_LOGIN=true,
# padrão) e para se ele não estiver ativo.

# --- Acesso ao VIOS (o mesmo usuário de leitura que a equipe usa) ---
# página de login (padrão: https://roneely.vios.com.br/entrar.php?)
SISTEMA_URL=
SISTEMA_USUARIO=
SISTEMA_SENHA=
# raiz do VIOS para montar os endereços das telas (vazio = a do SISTEMA_URL)
ORELHA_VIOS_BASE=

# --- Tela de login (padrões do VIOS; só mude se a tela mudar) ---
# padrão: css:input[name='form[usuario]']
LOGIN_CAMPO_USUARIO=
# padrão: css:input[name='form[senha]']
LOGIN_CAMPO_SENHA=
# vazio = aperta Enter no campo de senha
LOGIN_BOTAO=
# elemento que só aparece depois de logar (vazio = espera a URL mudar)
LOGIN_SUCESSO=

# --- Execução ---
# funções do relatório padrão, separadas por vírgula (parados é lenta: rode com --funcoes parados)
ORELHA_FUNCOES=agenda,prazos,intimacoes,planilhas
# true = Chrome sem janela (bom para o agendamento); false = dá para ver o que o Orelha faz
HEADLESS=true
# segundos de espera por cada tela
TIMEOUT=20
# true = o Chrome continua aberto quando o Orelha termina
MANTER_ABERTO=false
# pasta do relatório do dia (saida/<AAAA-MM-DD>/) e do histórico (saida/historico/); relativa a orelha/
ORELHA_SAIDA=saida
# pasta do log (logs/orelha.log); relativa a orelha/
ORELHA_LOGS=logs
# quando o agendamento roda o Orelha (o MESMO do cron/launchd; o Orelha não se agenda sozinho).
# A Vila 05 e a página /orelha do Sam usam para avisar quando sai o próximo relatório e se o de hoje
# atrasou. Formato "<dias> <HH:MM>", dias seg ter qua qui sex sab dom, com faixa (seg-sex) ou lista
# (seg,qua,sex); mais de um, separe com ";". Vazio = seg-sex 07:30
ORELHA_HORARIO=seg-sex 07:30
# o mesmo para os processos parados (--funcoes parados); vazio = sab 08:00, "nao" = não avisar
ORELHA_HORARIO_PARADOS=sab 08:00
# pasta dos resultados do Albi (planilhas); relativa a orelha/ (ou use --albi-saida)
ORELHA_ALBI_SAIDA=../albi/saida

# --- Proteções de somente leitura (vírgula separa; só acrescente, não tire) ---
# endereço com um destes trechos nunca é aberto (nem recebe XHR/fetch POST no modo pesquisa)
ORELHA_URL_PROIBIDA=act=del,act=excluir,act=apagar,act=salvar,act=gravar,act=concluir,int-lanca.php,excluir,apagar,concluir
# botão/link com um destes termos no texto nunca é clicado (nem envia formulário de pesquisa)
ORELHA_CLIQUE_PROIBIDO=SALVAR,GRAVAR,ENVIAR,CONCLUIR,EXCLUIR,APAGAR,LANCAR,CONFIRMAR,MARCAR COMO LIDO,MARCAR COMO LIDA,ARQUIVAR,CANCELAR TAREFA
# true (padrão) = o bloqueio de envios liga ANTES do login (o form de login é marcado pelo Orelha e
# passa; a página que abre depois do login já vem bloqueada). false = liga logo depois do login,
# como o Zangão. Use false só se o login falhar dizendo que o bloqueio barrou pedidos da tela de login.
ORELHA_BLOQUEIO_NO_LOGIN=
# no modo pesquisa (calendário, busca com XHR), XHR/fetch POST só passa para endereço com um destes
# trechos, ex.: o endpoint dos eventos do calendário. Vazio = qualquer endereço não proibido.
# A CONFERIR NA TELA REAL: ver no DevTools (Rede) para onde o calendário manda o POST e pôr aqui.
ORELHA_XHR_PERMITIDO=
# telas onde um formulário de PESQUISA pode ser enviado, além das padrão
# (int-pesquisa.php, processos-lista.php, calendario.php). Formulário de outra tela é recusado.
ORELHA_PESQUISA_PERMITIDA=

# --- Vila dos bots (opcional) ---
# a vila só assiste: o Orelha manda fases e contagens (nunca nomes ou números de processo)
# vazio = desligada. Ex.: http://<ip do Ultron>:5001/eventos (sem /eventos, o Orelha acrescenta)
VILA_URL=
# autenticação Basic do servidor do Ultron (mesma senha da página dele)
VILA_USUARIO=orelha
VILA_SENHA=
# segundos para desistir de cada envio
VILA_TIMEOUT=2

# =====================================================================================
# Funções. Tudo abaixo pode ficar vazio (vazio = o padrão escrito no comentário).
# "A CONFERIR" = palpite que ainda não foi visto na tela real do VIOS (ver orelha/README.md).
# =====================================================================================

# --- Calendário (lido pela agenda e pelos prazos) ---
# endereço do calendário (padrão: ?pag=sys/agenda/calendario.php&menu_lateral=true)
ORELHA_CALENDARIO_URL=
# seletor de cada evento; serve para esperar as tarefas chegarem por POST (padrão: css:.fc-event)
ORELHA_CALENDARIO_TAREFA=
# classe CSS do evento na leitura pelo HTML (padrão: fc-event)
ORELHA_CALENDARIO_CLASSE_EVENTO=
# contêiner do calendário, cujo HTML é interpretado (padrão: css:.fc)
ORELHA_CALENDARIO_AREA=
# botões de mês anterior e próximo (padrão: css:.fc-prev-button e css:.fc-next-button) — A CONFERIR
ORELHA_CALENDARIO_ANTERIOR=
ORELHA_CALENDARIO_PROXIMO=
# título do mês, para esperar a troca de mês (padrão: css:.fc-toolbar-title, .fc-toolbar h2, .fc-center h2)
ORELHA_CALENDARIO_TITULO=
# botão de visão (Semana/Lista) clicado antes de ler; vazio = a visão como abre.
# Use se a grade do mês esconde eventos em "+N mais" — A CONFERIR
ORELHA_CALENDARIO_VISAO=
# um campo do formulário de filtro do calendário (o form é o dele). Sem ele, ORELHA_AGENDA_FILTROS e
# ORELHA_PRAZOS_FILTROS não são aplicados e a seção avisa — A CONFERIR
ORELHA_CALENDARIO_FILTRO_CAMPO=
# true (padrão) = o Pesquisar do calendário recarrega a página; false = só refaz por AJAX — A CONFERIR
ORELHA_CALENDARIO_PESQUISA_RECARREGA=
# mapa campo=propriedade;... das propriedades do evento no FullCalendar (campos: responsavel,
# limite, conclusao, concluida, tipo). Vazio = o Orelha adivinha pelo nome. Ex.: responsavel=resp;limite=dt_limite
ORELHA_CALENDARIO_CAMPOS=
# trechos do link que identificam uma tarefa (e não compromisso/feriado) (padrão: pxe.php,pxe_id)
ORELHA_CALENDARIO_LINK_TAREFA=
# marcas (classe, propriedade ou tooltip) de feriado (padrão: feriado; nacionais também pelo nome)
ORELHA_CALENDARIO_FERIADO=

# --- 1. Agenda de hoje e amanhã ---
# filtro do calendário para a agenda: nome_do_campo=valor;nome=valor (valor vazio limpa o campo).
# Precisa de ORELHA_CALENDARIO_FILTRO_CAMPO
ORELHA_AGENDA_FILTROS=
# nomes de <select multiple> em que marcar todas as opções, separados por vírgula
ORELHA_AGENDA_MARCAR_TODAS=
# tipo/título com um destes termos entra na agenda (padrão: AUDIÊNCIA,PERÍCIA,REUNIÃO,SUSTENTAÇÃO,OITIVA,DILIGÊNCIA)
# de onde vêm as tarefas da agenda: lista (padrão) = lista de tarefas do VIOS, equipe toda;
# calendario = as do calendário (só do usuário logado, agrupadas por tipo)
ORELHA_AGENDA_TAREFAS_FONTE=
ORELHA_AGENDA_TERMOS=
# termos que, numa tarefa de hoje, dão nível "atenção" (padrão: AUDIÊNCIA,PERÍCIA)
ORELHA_AGENDA_TERMOS_ATENCAO=
# true = qualquer tarefa com hora entra na agenda, mesmo sem os termos (padrão: false)
ORELHA_AGENDA_TAREFAS_COM_HORA=
# true = mostra os aniversários de hoje e amanhã (padrão: false)
ORELHA_AGENDA_ANIVERSARIOS=

# --- 2. Placar de prazos atrasados (equipe inteira) ---
# de onde vem o placar: lista (padrão) = a lista de tarefas do VIOS (pxe-lista.php), aberta por GET com
# os filtros no endereço; traz a equipe toda (conferido na tela em 04/11/2026). calendario = a leitura
# antiga pelo calendário (as variáveis ORELHA_PRAZOS_FILTROS até ORELHA_PRAZOS_FICHA_AREA só valem nela)
ORELHA_PRAZOS_FONTE=
# desde quando procurar tarefas atrasadas na lista, DD/MM/AAAA (padrão: 01/01/2000 = todas)
ORELHA_PRAZOS_DESDE=
# atrasada há mais de N dias = urgente; até N dias = atenção (padrão: 7). Vencem hoje ficam à parte.
ORELHA_PRAZOS_DIAS_GRAVE=
# máximo de páginas da lista de tarefas por execução (padrão: 60; cada página tem até 1000 tarefas)
ORELHA_PRAZOS_MAX_PAGINAS=
# (só com ORELHA_PRAZOS_FONTE=calendario) filtro do calendário para ler a EQUIPE TODA: nome_do_campo=valor;nome=valor, ex.: Concluída = Não e
# Responsável vazio. Vazio = o calendário como abre (pode ser só o usuário do Orelha; a seção avisa) — A CONFERIR
ORELHA_PRAZOS_FILTROS=
# <select multiple> em que marcar todas as opções (ex.: a lista de responsáveis), separados por vírgula
ORELHA_PRAZOS_MARCAR_TODAS=
# quantos meses antes do atual o placar lê (padrão: 2). Atrasada mais antiga que isso fica de fora (com aviso)
ORELHA_PRAZOS_MESES_ANTERIORES=
# o que a data do evento no calendário representa: conclusao (padrão) ou limite — A CONFERIR
ORELHA_PRAZOS_DATA_CALENDARIO=
# máximo de fichas de tarefa (pxe.php, por GET, bloqueio total) abertas por execução para completar
# responsável e data limite (padrão: 30; 0 = nenhuma)
ORELHA_PRAZOS_ABRIR_TAREFAS=
# trecho da ficha da tarefa de onde ler o texto (vazio = a página inteira)
ORELHA_PRAZOS_FICHA_AREA=

# --- 3. Intimações esquecidas (sem tarefa) ---
# até quantos dias para trás a pesquisa vai (padrão: 15; maior que zero)
# url (padrão) = abre a pesquisa pelo endereço, sem filtro de Área (o "Marcar todas" deixava de fora
# as intimações sem área: 3 de 5 no teste de 04/11/2026); formulario = envia o formulário da tela
ORELHA_INTIMACOES_LEITURA=
ORELHA_INTIMACOES_DIAS=
# disponibilizada há mais que estes dias vira "grave" (padrão: 5)
ORELHA_INTIMACOES_GRAVE_DIAS=
# true (padrão) = deixa de fora também o que o Ultron ainda vai tratar hoje (na segunda ele trata
# sexta a domingo, então o Orelha para na quinta); false = exclui só ontem e hoje
ORELHA_INTIMACOES_SEGUIR_ULTRON=
# tela "Pesquisa intimações" (padrão: index.php?pag=sys/publicacoes/int-pesquisa.php)
ORELHA_INTIMACOES_URL=
# um campo do formulário da pesquisa, para achar o form (padrão: css:input[name='pesq[fdata]'])
ORELHA_INTIMACOES_CAMPO_DATA=
# linhas de dados do resultado (padrão: css:tr[id*='_linha_'])
ORELHA_INTIMACOES_LINHAS=
# <select multiple> em que fazer "Marcar todas", separados por | (padrão: pesq[pr_areas_id][])
ORELHA_INTIMACOES_MARCAR_TODAS=
# valor de "Mostrar" (pesq[limit]); se o rodapé disser que há mais, a seção avisa (padrão: 500)
ORELHA_INTIMACOES_LIMITE=
# filtros a mais: nome=valor|nome=valor (ex.: o campo de "Com Tarefa Lançada" = Não). Vazio = o
# padrão da tela, como no Ultron — A CONFERIR
ORELHA_INTIMACOES_FILTROS_EXTRA=

# processos parados: filtro (padrão) = filtro do VIOS "sem tarefa aberta" na lista de processos;
# fichas = leitura antiga (abre a ficha de cada processo; lenta)
ORELHA_PARADOS_FONTE=
# desde quando ler, por data de cadastro, quando há mais de 500 parados (padrão: 01/01/2000)
ORELHA_PARADOS_DESDE=
# máximo de páginas da lista de processos por execução (padrão: 60) e tempo de cada uma em s (padrão: 180)
ORELHA_PARADOS_MAX_PAGINAS=
ORELHA_PARADOS_TIMEOUT=
# --- 4. Processos parados (lenta: rode com --funcoes parados, no agendamento semanal) ---
# máximo de fichas lidas por execução; a próxima continua dali (padrão: 300; 0 = sem limite)
ORELHA_PARADOS_MAX=
# urgente: com ORELHA_PARADOS_FONTE=filtro, sem edição há mais de N dias (padrão: 60); com =fichas,
# última conclusão há mais de N dias (padrão: 90)
ORELHA_PARADOS_DIAS_GRAVE=
# agrupar por: area (padrão) | cliente | advogado | nenhum
ORELHA_PARADOS_AGRUPAR=
# tempo máximo lendo fichas, em minutos; o resto fica para a próxima (padrão: 0 = sem limite)
ORELHA_PARADOS_MINUTOS=
# pesq[clientes_grupos_id] da pesquisa da lista (padrão: 0 = TODOS)
ORELHA_PARADOS_GRUPO_CLIENTE=
# pesq[limit] da lista (padrão: 9999999 = sem limite; se a opção não existir, a função para)
ORELHA_PARADOS_LIMITE_LISTA=
# lista de processos (padrão: ?pag=sys/processos/processos-lista.php&menu_lateral=true)
ORELHA_PARADOS_URL_LISTA=
# ficha, precisa ter {ci} (padrão: ?pag=sys/processos/processos-vis.php&processos_id={ci})
ORELHA_PARADOS_URL_FICHA=
# começo do id das linhas <tr> da lista (padrão: processos-lista_linha_)
ORELHA_PARADOS_PREFIXO_LINHA=
# campo pesq[limit]; o form da pesquisa é o dele (padrão: css:[name='pesq[limit]'])
ORELHA_PARADOS_CAMPO_LIMITE=
# botão Pesquisar dentro do form, CSS SEM o prefixo css: (padrão: #Pesq; senão o [type=submit])
ORELHA_PARADOS_BOTAO_PESQUISA=
# botão "próxima página", só se a lista um dia vier paginada (vazio = sem paginação)
ORELHA_PARADOS_PROXIMA_PAGINA=
# posição (a partir de 0) das colunas da tabela de Tarefas da ficha (padrão: ci=1,tipo=2,datas=5) — A CONFERIR
ORELHA_PARADOS_COLUNAS_TAREFA=
# segundos de espera pela lista inteira (padrão: 180)
ORELHA_PARADOS_TIMEOUT_LISTA=
# segundos de espera por cada ficha (padrão: o TIMEOUT)
ORELHA_PARADOS_TEMPO_FICHA=
# nao (padrão) | auto | sim. Se a ficha (Vue) só carrega por XHR POST, o bloqueio total barra e a
# ficha vira "não lida". auto = libera XHR/fetch pelo resto da leitura quando isso acontece; sim =
# libera desde o começo. Formulário e sendBeacon continuam barrados. Só mude depois de conferir na
# tela real que a ficha não grava nada ao abrir — A CONFERIR
ORELHA_PARADOS_LIBERAR_XHR=

# --- 5. Conferência das planilhas do Albi ---
# url (padrão) = a busca do topo pelo endereço, "Nro do Processo", um número por vez (conferida em
# 04/11/2026) | busca = a mesma busca pela tela | lista = uma pesquisa na lista de processos inteira
ORELHA_PLANILHAS_MODO=
# máximo de processos conferidos por execução; o resto fica para a próxima (padrão: 300; 0 = sem limite)
ORELHA_PLANILHAS_MAX=
# só confere processos.csv dos últimos N dias (padrão: 30; 0 = todos)
ORELHA_PLANILHAS_DIAS=
# com pelo menos tantas buscas e NENHUM processo achado, o resultado é suspeito: aviso e nenhuma
# planilha marcada como conferida (padrão: 10; 0 = desliga)
ORELHA_PLANILHAS_SUSPEITO=
# busca por endereço (GET) com {numero} (CNJ já codificado) ou {digitos}; vazio = formulário da busca do topo — A CONFERIR
ORELHA_PLANILHAS_BUSCA_URL=
# página aberta antes da busca do topo (padrão: ?pag=sys/processos/processos-lista.php&menu_lateral=true)
ORELHA_PLANILHAS_BUSCA_PAGINA=
# campo de texto da busca do topo (padrão, PALPITE: css:input[name*='busca' i], input[id*='busca' i]) — A CONFERIR
ORELHA_PLANILHAS_BUSCA_CAMPO=
# <select> com a opção "Nro do Processo" (vazio = procura um select/rádio no form do campo) — A CONFERIR
ORELHA_PLANILHAS_BUSCA_TIPO=
# texto ou value da opção do tipo de busca (padrão: Nro do Processo)
ORELHA_PLANILHAS_BUSCA_OPCAO=
# como digitar o número: cnj (padrão, 0000000-00.0000.0.00.0000) | digitos — A CONFERIR
ORELHA_PLANILHAS_BUSCA_FORMATO=
# true (padrão) = a busca recarrega a página; false = resultado por AJAX — A CONFERIR
ORELHA_PLANILHAS_BUSCA_RECARREGA=
# true = libera XHR/fetch POST durante a busca, se ela buscar assim (padrão: false) — A CONFERIR
ORELHA_PLANILHAS_BUSCA_XHR=
# elemento que só aparece com o resultado pronto; se não aparecer, o número vira "não deu para conferir"
ORELHA_PLANILHAS_BUSCA_PRONTO=
# área dos resultados onde procurar o número (vazio = a página inteira); se não aparecer, "não deu para conferir"
ORELHA_PLANILHAS_BUSCA_RESULTADO=
# modo lista: página, campo do form, filtro e linhas (padrões mapeados em 03/11/2026)
# (padrões: ?pag=sys/processos/processos-lista.php&menu_lateral=true | css:[name='pesq[limit]'] | todos | css:tr[id^='processos-lista_linha_'])
ORELHA_PLANILHAS_LISTA_URL=
ORELHA_PLANILHAS_LISTA_CAMPO=
ORELHA_PLANILHAS_LISTA_FILTRO=
ORELHA_PLANILHAS_LISTA_LINHAS=

# ---- painel semanal (peças + audiências, PDF no papel timbrado) -- só com --funcoes painel
# Fila = tarefas abertas da equipe cujo TIPO começa com um destes termos (separados por vírgula) e com data para
# conclusão até hoje + ORELHA_PAINEL_DIAS_FILA dias; o período do painel é de hoje até hoje + esses dias.
# (padrões: MINUTAR | AUDIÊNCIA | 7)
ORELHA_PAINEL_TERMOS_PECA=
ORELHA_PAINEL_TERMOS_AUDIENCIA=
# a fila tem todos os tipos de tarefa; os que não são peça nem audiência entram como "Outras" (padrão sim).
# nao = só peças e audiências, como antes de 23/11/2026
ORELHA_PAINEL_OUTRAS=
ORELHA_PAINEL_DIAS_FILA=
# dias da agenda de audiências (padrão 7)
ORELHA_PAINEL_DIAS_AGENDA=
# advogado com tantas tarefas "urgente ≤7d" ou mais aparece em vermelho na carga (padrão 15)
ORELHA_PAINEL_URGENTE_ALTO=
# leitura da taxa de resolução: Boa a partir de TAXA_BOA %, Atenção a partir de TAXA_ATENCAO %, senão Baixa (padrões 70 e 60)
ORELHA_PAINEL_TAXA_BOA=
ORELHA_PAINEL_TAXA_ATENCAO=
# A leitura usa ORELHA_PRAZOS_DESDE e ORELHA_PRAZOS_MAX_PAGINAS (os mesmos dos prazos).
