# Albi — bot do Sonar (Leme Forense)
# Copie este arquivo para albi/.env (cp .env.example .env, dentro da pasta albi/) e preencha.
# O .env fica só neste computador: ele NUNCA vai para o git (está no .gitignore).
# Escreva cada valor logo depois do "=", sem espaço antes ou depois.

# --- Acesso ao Sonar ---
SONAR_URL=https://sonar.lemeforense.com.br/login

# CPF ou CNPJ do login. Pode ser só os números (12345678900) ou com pontuação
# (123.456.789-00); o Albi tira a pontuação antes de digitar.
SONAR_CPF_CNPJ=

# E-mail do login (o mesmo que você digita no Sonar).
SONAR_EMAIL=

# Senha do login. Normalmente sem aspas: SONAR_SENHA=Abc123#
# Se a senha tiver ESPAÇO, ou um # depois de espaço, ponha entre aspas simples:
#   SONAR_SENHA='minha senha #1'
# (sem as aspas, tudo depois de " #" seria tratado como comentário e a senha ficaria cortada).
# Se a senha tiver aspas simples ('), use aspas duplas: SONAR_SENHA="d'Avila123"
SONAR_SENHA=

# --- Campos da tela de login (só mude se a tela do Sonar mudar) ---
# Formato css:<seletor> ou xpath:<expressão>. Presos ao formulário #loginform porque a mesma
# página tem o formulário de "esqueci a senha" com campos de mesmo nome. Escritos com
# [id=...] e sem " #" porque, sem aspas, tudo depois de " #" vira comentário no .env.
LOGIN_CAMPO_CPF_CNPJ=css:#loginform input[id=input-cpf-cnpj]
LOGIN_CAMPO_EMAIL=css:#loginform input[id=loginform-username]
LOGIN_CAMPO_SENHA=css:#loginform input[id=loginform-password]
LOGIN_BOTAO=css:#loginform [id=btn-login]
# botão "Encerrar a outra sessão" da tela /login-conflito (vazio = o padrão do Albi)
CONFLITO_BOTAO=

# --- Execução ---
# true = Chrome sem janela
HEADLESS=false
# segundos de espera por cada elemento da tela
TIMEOUT=20
