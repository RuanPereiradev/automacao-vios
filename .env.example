# Copie este arquivo para .env e preencha usuário e senha.
# Seletores: "css:<seletor css>" ou "xpath:<expressão xpath>".
# Variável vazia ou ausente = padrão do bot (o valor mostrado aqui).

# --- Acesso (obrigatório) ---
SISTEMA_URL=https://roneely.vios.com.br/entrar.php?
SISTEMA_USUARIO=
SISTEMA_SENHA=
LOGIN_CAMPO_USUARIO=css:input[name='form[usuario]']
LOGIN_CAMPO_SENHA=css:input[name='form[senha]']
# vazio = aperta Enter no campo de senha
LOGIN_BOTAO=
# vazio = espera a URL sair da tela de login
LOGIN_SUCESSO=

# --- Calendário ---
CALENDARIO_URL=https://roneely.vios.com.br/?pag=sys/agenda/calendario.php&menu_lateral=true
# cada tarefa do calendário (o elemento ou um <a> dentro dele tem o link da tarefa)
CALENDARIO_TAREFA=css:.fc-event
# texto que a tarefa previdenciária tem (sem diferença de acento/maiúscula)
CALENDARIO_FILTRO=PREVIDENCI
# tipo de tarefa processado (as outras previdenciárias são ignoradas)
CALENDARIO_TIPO=EDITAR OS DADOS DA ACAO PROTOCOLADA

# --- Processo e comprovante ---
# número do processo na tarefa (abre um modal) e o "Visualizar" do modal (tem que haver exatamente 1 de cada)
PROCESSO_NUMERO=xpath://p[.//strong//span[normalize-space()='Processo']]//a[.//i[contains(@class,'vj-icon-processo')]]
PROCESSO_LINK=xpath://div[contains(@class,'vj-panel-body')]//a[normalize-space()='Visualizar' and contains(@href,'processos-vis.php')]
# valor do campo N.° CNJ na tela do processo
PROCESSO_CNJ=xpath://p[strong/span[normalize-space()='N.° CNJ']]/span[not(contains(@class,'vj-acoes-dados'))]
# tarefa da tabela do processo que tem o comprovante, linhas da tabela e o "Visualizar arquivo" da linha
PROTOCOLO_TAREFA=PROTOCOLAR INICIAL (PREVIDENCIARIO)
PROTOCOLO_LINHAS=css:#tabela_v5_processo_vis_tabela_tarefas tbody tr
PROTOCOLO_ARQUIVOS=css:a[data-tippy-content='Visualizar arquivo']
# arquivos da galeria e o nome do comprovante (tem que sobrar exatamente 1; aceita "Protcolo")
COMPROVANTE_LINK=css:.vios-file-box a.vj-arquivo-thumbnail
COMPROVANTE_TEXTO=comprovante[\s_-]+de[\s_-]+prot(?:o)?colo

# --- Tela de edição do processo ---
# lápis do N.° CNJ na tela do processo (abre a tela de edição)
EDICAO_LINK=xpath://p[.//strong//span[normalize-space()='N.° CNJ']]//i[contains(@class,'vj-icon-edit')]
EDICAO_GRAVAR=css:#processo_gravar
# aviso depois de Gravar que o bot responde com Confirmar (regex sobre o texto sem acento,
# em maiúsculas); qualquer outro aviso não é respondido e a tarefa vai para "conferir"
EDICAO_CONFIRMAR=CLIENTE DO CONTRATO NAO E CATEGORIZADO COMO CLIENTE
# campos: vazio = o bot acha pelo rótulo ("N.° CNJ", "Órgão julgador (Vara/câmara)",
# "Valor da ação"); preencha só se o rótulo não estiver ligado ao campo
CAMPO_CNJ=
CAMPO_ORGAO=
CAMPO_VALOR=
# órgão do PDF que não está na lista: "+" do campo, nome no modal e Gravar do modal
# (o Gravar do modal só é clicado com --confirmar)
ORGAO_CADASTRAR=css:#label_vara_id a[title^='Cadastrar']
ORGAO_NOME=css:textarea[name='form[varas_nome]']
ORGAO_GRAVAR=css:#gravar_vara

# --- Vila dos bots (opcional) ---
# a vila só assiste: o bot manda cada etapa ao servidor do Ultron, que guarda e serve à vila
# vazio = vila desligada. Ex.: http://<ip do Ultron>:5001/eventos
VILA_URL=
# autenticação Basic do servidor do Ultron (mesma senha da página dele)
VILA_USUARIO=zangao
VILA_SENHA=
# segundos para desistir de cada envio (o bot não espera mais que isso)
VILA_TIMEOUT=2

# --- Execução ---
SAIDA_PASTA=saida
HEADLESS=false
TIMEOUT=20
# true = navegador continua aberto quando o bot termina
MANTER_ABERTO=false
