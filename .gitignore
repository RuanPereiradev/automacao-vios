.venv/
__pycache__/
.env
# .env de outros usuários (ex.: .env.usuario2); os modelos .example são versionados
.env.*
!.env*.example
saida/
saida_*/
logs/
# prints de tela podem ter dados de clientes
imgs/
doc/*.png
doc/*.jpg
doc/*.jpeg
# clone do repositório da vila (RuanPereiradev/autobots), versionado à parte
autobots/
# perfil do Chrome do Albi com a sessão do Presto (Oystr)
albi/perfil_presto/
# resultado do Albi tem CPF e nome de clientes (ex.: um copiado para cá do Mac)
resultado*.txt
# Orelha: senha, relatórios (têm nomes da equipe e de clientes), log e ambiente próprios
orelha/.env
orelha/saida/
orelha/logs/
orelha/.venv/
