# Presto (login no PJe do TRT7). Preencha no seu .env local; não cole valores aqui.
# Login do console do Presto (console.presto.oystr.com.br): o robô entra no console e abre o TRT7 pela página Sites.
PRESTO_EMAIL=
PRESTO_SENHA=
PRESTO_CREDENCIAL=
# PIN do quadro do Presto (senha da credencial)
PRESTO_PIN=

# Vigia VIOS → PJe (vigia.py). Lê o VIOS pela sessão aberta no Chrome; usuário/senha só são usados se a sessão cair.
VIOS_USUARIO=
VIOS_SENHA=
# Filtros da lista de processos (PROJETO (1).md, seção 4.2): 3 = Trabalhista; P = cliente na parte passiva
VIGIA_VIOS_AREA_ID=3
VIGIA_VIOS_TIPO_PARTE=P
# Opcional: só estes advogados (ids do filtro, separados por |). Vazio = todos.
VIGIA_VIOS_ADVOGADO_ID=
# Quantas empresas por rodada têm o CNPJ consultado no cadastro de pessoas (as novas primeiro)
VIGIA_MAX_CNPJ=40
# DJEN (vigia.py djen): tribunal pesquisado e pausa (segundos) entre consultas
VIGIA_DJEN_TRIBUNAL=TRT7
VIGIA_DJEN_PAUSA_S=1.5
# Advogados do escritório nas publicações do DJEN (regex no nome ou nº da OAB); vazio = FEITOSA
VIGIA_ESCRITORIO_ADVOGADOS=
