# Modelo do jarvis/.env (Jarvis: relatório mensal de processos com o SEGUNDO usuário do VIOS).
# O ./instalar.sh copia este arquivo para jarvis/.env; preencha usuário, senha e a chave da IA.
# O .env não vai para o GitHub (está no .gitignore).
# Seletores: "css:<seletor css>" ou "xpath:<expressão xpath>"

# --- Acesso (mesmo VIOS do robô de intimações, outro usuário) ---
SISTEMA_URL=https://roneely.vios.com.br/entrar.php?
SISTEMA_USUARIO=
SISTEMA_SENHA=

# --- Tela de login (igual à do robô de intimações) ---
LOGIN_CAMPO_USUARIO=css:input[name='form[usuario]']
LOGIN_CAMPO_SENHA=css:input[name='form[senha]']
# vazio = aperta Enter no campo de senha
LOGIN_BOTAO=
# vazio = espera a URL sair da tela de login
LOGIN_SUCESSO=

# --- Caminho até a tela da função nova ---
# cliques em ordem, separados por "|" (pode deixar vazio)
NAVEGACAO_PASSOS=
# tela de Relatórios do VIOS (a função nova parte daqui)
NAVEGACAO_URL_FINAL=https://roneely.vios.com.br/?pag=sys/relatorios/relatorios.php

# --- Relatório mensal de processos por Grupo Cliente (relatorio_processos.py) ---
# grupos do filtro "Grupo Cliente", separados por "|"; uma planilha por grupo. São os grupos que a
# pessoa pode marcar na página /jarvis (pela plataforma, só os marcados rodam)
PROCESSOS_GRUPOS=PLASFRAN ITAPIPOCA|PLASFRAN CAMOCIM|PLASFRAN MARANHÃO|LD URBANISMO|CASA DO CELULAR|CASA DO CELULAR MG/SP
# pasta das planilhas (vazio = <SAIDA_PASTA>/relatorios); cada mês ganha a subpasta AAAA-MM
RELATORIO_PASTA=
# grupos com o relatório COMPLETO (o formato pedido pela Casa do Celular), separados por "|";
# os outros saem no resumido (número, partes, resumo, cidade/tribunal). Vazio = as duas Casas do Celular
RELATORIO_COMPLETO=CASA DO CELULAR|CASA DO CELULAR MG/SP
# quadro "Percentual ganho" (pedido x pago, ativos e encerrados) em todos os relatórios: true/false
PERCENTUAL_GANHO=true

# --- IA (colunas Resumo, Motivação, Financeira e Documentos faltando) ---
# anthropic | openai | gemini
LLM_PROVEDOR=anthropic
# vazio = o padrão do provedor (anthropic: claude-sonnet-5-5; openai: gpt-5.6; gemini: gemini-3.6-flash)
LLM_MODELO=
# teto de gasto por execução, em US$ (vazio ou 0 = sem teto)
LLM_LIMITE_US=5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini: use um projeto com faturamento ativo (no plano gratuito o Google pode usar os dados enviados)
GEMINI_API_KEY=

# --- Execução ---
# planilhas e dados ficam em jarvis/saida/ (separados do Sam)
SAIDA_PASTA=saida
# no Mac (rodando pela vila) usar true: não abre janela do Chrome
HEADLESS=false
TIMEOUT=20
# true = navegador continua aberto quando o bot termina (útil para mapear a tela nova)
MANTER_ABERTO=false

# --- Vila do Ultron (Vila 04 · Jarvis) ---
# endereço dos eventos do Ultron (vazio = vila desligada); no Mac: http://127.0.0.1:5001/eventos
VILA_URL=
# a mesma senha do ENVIO_SENHA do Ultron (vazio se a página do Ultron não tem senha)
VILA_SENHA=
