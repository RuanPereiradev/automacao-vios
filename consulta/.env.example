# Coletor da consulta de processo — copie para consulta/.env e preencha (o .env não vai para o git).
# O coletor SÓ LÊ o VIOS (o mesmo bloqueio de envios da Orelha, ligado antes do login) e conversa com o
# bot só por saída (HTTPS). Nada daqui é impresso em log.

# --- O bot (os valores saem de `scripts/gerar-chaves-consulta`, no repositório do bot) ---
# endereço do bot, sem barra no fim (ex.: https://bot-exemplo.onrender.com)
CONSULTA_BOT_URL=
# o MESMO CONSULTA_SEGREDO do bot (assina as chamadas)
CONSULTA_SEGREDO=
# a MESMA CONSULTA_CHAVE_TELEFONE do bot (HMAC dos telefones do cadastro)
CONSULTA_CHAVE_TELEFONE=
# caminho do PEM da chave PRIVADA RSA (a pública é a CONSULTA_CHAVE_PUBLICA do bot). O arquivo precisa
# ser 600 (chmod 600) e fica só neste Mac
CONSULTA_CHAVE_PRIVADA=
# segundos entre uma busca de pedidos e a seguinte
CONSULTA_INTERVALO=5
# segundos de espera por resposta do bot
CONSULTA_TIMEOUT_HTTP=15

# --- Leitura do VIOS (conferir na tela real antes de ligar; ver README) ---
# como o CPF vai nos filtros da lista de processos e de pessoas: mascara (000.000.000-00) ou digitos
CONSULTA_CPF_FORMATO=mascara
# sim = só aceita a lista de processos se a tela mostrar o filtro pesq[cpfcnpj] com o CPF pedido (evita
# listar processos de todo mundo se o filtro não for aplicado). Só mude para nao depois de conferir
CONSULTA_EXIGIR_ECO_CPF=sim
# segundos de espera por cada página lida por GET
CONSULTA_TIMEOUT_BUSCA=60
# pasta do log (consulta.log): só id do pedido, status e tempos
CONSULTA_LOGS=logs

# --- Ficha do processo ---
# OBRIGATÓRIO deixar auto: a tabela de tarefas da ficha carrega por XHR POST, que o bloqueio de envios
# barra; sem isso ela vem vazia e toda fase sai "desconhecida". Com auto, o coletor só libera XHR/fetch
# (o envio de formulário e o sendBeacon continuam barrados) quando vê a tabela vazia por causa disso.
ORELHA_PARADOS_LIBERAR_XHR=auto

# --- Acesso ao VIOS (o mesmo formato da Orelha; usuário só de leitura recomendado) ---
# página de login (padrão: https://roneely.vios.com.br/entrar.php?)
SISTEMA_URL=
SISTEMA_USUARIO=
SISTEMA_SENHA=
# true = Chrome sem janela
HEADLESS=true
# segundos de espera por cada tela
TIMEOUT=20
# Seletores de login, proteções e demais variáveis ORELHA_* têm os mesmos padrões e o mesmo significado da
# Orelha (orelha/.env.example). Não afrouxe ORELHA_URL_PROIBIDA nem ORELHA_CLIQUE_PROIBIDO.
