# Copie este arquivo para .env e preencha.
# Seletores: "css:<seletor css>" ou "xpath:<expressão xpath>"

# --- Acesso ---
SISTEMA_URL=https://sistema.interno/login
# VIOS com certificado vencido: impressão digital SHA-256 do certificado vencido que o robô pode aceitar
# (só esse; se o VIOS mostrar outro, o Chrome confere normalmente). Vazio = normal. Tirar quando o VIOS renovar.
# Para ver a impressão: echo | openssl s_client -connect roneely.vios.com.br:443 -servername roneely.vios.com.br 2>/dev/null | openssl x509 -noout -fingerprint -sha256
VIOS_CERTIFICADO_VENCIDO=
SISTEMA_USUARIO=
SISTEMA_SENHA=

# --- Tela de login ---
LOGIN_CAMPO_USUARIO=css:#username
LOGIN_CAMPO_SENHA=css:#password
# vazio = aperta Enter no campo de senha
LOGIN_BOTAO=css:button[type=submit]
# elemento que só aparece depois de logar (vazio = espera a URL mudar)
LOGIN_SUCESSO=css:#menu-principal

# --- Caminho até a tabela ---
# cliques em ordem, separados por "|" (pode deixar vazio)
NAVEGACAO_PASSOS=xpath://a[text()='Relatórios']|css:#menu-vendas
# opcional: URL direta da tela da tabela (usada depois dos passos)
NAVEGACAO_URL_FINAL=

# --- Dados (vazio = não extrai nada) ---
TABELA=css:table#resultado
TABELA_TEM_CABECALHO=true

# --- Dados em cards (alternativa à tabela; tem prioridade) ---
# CARD = cada item; CARD_CABECALHO e CARD_TEXTO = partes dentro do card
CARD=
CARD_CABECALHO=
CARD_TEXTO=

# --- Pesquisa de intimações por data (tem prioridade sobre CARD e TABELA) ---
# campo de data da pesquisa (vazio = não pesquisa). O bot preenche início e fim
# com hoje - PESQUISA_DIAS_ATRAS (1 = ontem) e lista até 500 intimações
PESQUISA_CAMPO_DATA=css:input[name='pesq[fdata]']
PESQUISA_DIAS_ATRAS=1
# filtros em que o bot clica "Marcar todas", separados por "|":
# pesq[pr_areas_id][] (Área), pesq[advogados_id][] (Advogados), pesq[impTribunais][] (Tribunais)
PESQUISA_MARCAR_TODAS=

# --- Análise das intimações com IA (agente com a skill da Controladoria) ---
# true = depois de capturar, analisa e gera saida/analise_*.md (também: ./rodar_analise.sh)
ANALISE_ATIVA=false
# openai ou anthropic (para trocar, mude aqui e a chave correspondente)
LLM_PROVEDOR=openai
# vazio = padrão do provedor (openai: gpt-5.6 / anthropic: claude-opus-5-5)
LLM_MODELO=
# esforço de raciocínio: low, medium, high (vazio = padrão do modelo)
LLM_ESFORCO=medium
# Análise em lote (Batch API da OpenAI ou Message Batches do Claude, metade do preço; resposta em minutos, até horas)
LLM_LOTE=true
# Tempo máximo esperando o lote; passou disso, cancela e analisa o resto uma a uma (preço normal)
LLM_LOTE_ESPERA_MIN=360
# Triagem: modelo mais barato para as intimações simples (despacho, laudo, ciência...).
# Intimação que cita sentença/decisão/acórdão/audiência/RPV/recurso vai direto para o
# LLM_MODELO; a resposta do barato que mostrar algo importante é refeita pelo LLM_MODELO.
# Vazio = desligado (tudo no LLM_MODELO). Confirmar o nome exato do modelo na conta da OpenAI.
LLM_MODELO_SIMPLES=
# Modelo da pesquisa de feriados na internet (vazio = LLM_MODELO)
LLM_MODELO_FERIADOS=
# Teto de gasto com a IA por execução, em US$ (vazio ou 0 = sem teto). Passou do teto,
# as CIs que faltam ficam com erro e não são lançadas no VIOS.
LLM_LIMITE_US=
# Preços (US$ por milhão de tokens, entrada/saída) para corrigir a tabela do bot/custo.py
# ex.: gpt-5.6=5/30,gpt-5.6-luna=1/6 (vazio = tabela do código)
LLM_PRECOS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SKILL_PASTA=doc/analise-intimacoes-controladoria
# tabela de feriados nacionais, estaduais, capitais e pontos facultativos
FERIADOS_TABELA=doc/feriados-brasil-2026-2027.md
# feriados/suspensões extras: "DD/MM/AAAA ; ESCOPO ; descrição"
# ESCOPO = TODOS, JUSTIÇA FEDERAL, JUSTIÇA ESTADUAL, UF (ex.: CE) ou CIDADE/UF (ex.: SOBRAL/CE)
FERIADOS_ARQUIVO=doc/feriados.txt
# Pesquisa na internet de feriados e suspensões de prazo antes da análise (true/false)
FERIADOS_PESQUISA=true

# --- Execução ---
SAIDA_PASTA=saida
HEADLESS=false
TIMEOUT=20
# true = navegador continua aberto quando o bot termina
MANTER_ABERTO=false
# true = o navegador não espera recursos do VIOS que o robô não usa (ganho pequeno; false = como antes)
NAVEGADOR_RAPIDO=true

# --- Página de envio do .txt (./rodar_envio.sh) ---
# true = abre para os outros computadores da rede (http://<IP desta máquina>:5001)
ENVIO_REDE=false
# obrigatória com ENVIO_REDE=true: o navegador pede usuário (qualquer) e esta senha
ENVIO_SENHA=
# pasta do Zangão (bot de comprovantes previdenciários) neste computador, com .venv e .env dele;
# com ela, a Vila 02 ganha os botões "Testar sem gravar" e "Rodar e gravar no VIOS". Vazio = sem botões
ZANGAO_PASTA=
# pasta do Albi (bot do Sonar), com .venv e .env dele; vazio = a pasta albi/ deste repositório
ALBI_PASTA=
# pasta do Jarvis (relatório mensal de processos), com .venv e .env dele; vazio = a pasta jarvis/ deste
# repositório. Instalado (cd jarvis && ./instalar.sh), a Vila 04 ganha os botões e a página /jarvis
JARVIS_PASTA=
# pasta do Orelha (relatório do dia): o Sam lê dela o horário e os relatórios guardados (página /orelha);
# vazio = a pasta orelha/ deste repositório
ORELHA_PASTA=
