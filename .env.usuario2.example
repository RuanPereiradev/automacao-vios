# Modelo do .env do SEGUNDO usuário do VIOS (mesmo escritório, função nova).
# Copie para .env.usuario2 e preencha usuário e senha:
#   cp .env.usuario2.example .env.usuario2
# O .env.usuario2 não vai para o GitHub (está no .gitignore).
# Seletores: "css:<seletor css>" ou "xpath:<expressão xpath>"

# --- Acesso (mesmo VIOS do robô de intimações, outro usuário) ---
SISTEMA_URL=https://roneely.vios.com.br/entrar.php?
SISTEMA_USUARIO=
SISTEMA_SENHA=

# --- Tela de login (igual à do robô de intimações) ---
LOGIN_CAMPO_USUARIO=css:input[name='form[usuario]']
LOGIN_CAMPO_SENHA=css:input[name='form[senha]']
# vazio = aperta Enter no campo de senha
LOGIN_BOTAO=
# vazio = espera a URL sair da tela de login
LOGIN_SUCESSO=

# --- Caminho até a tela da função nova ---
# cliques em ordem, separados por "|" (pode deixar vazio)
NAVEGACAO_PASSOS=
# tela de Relatórios do VIOS (a função nova parte daqui)
NAVEGACAO_URL_FINAL=https://roneely.vios.com.br/?pag=sys/relatorios/relatorios.php

# --- Relatório de processos por Grupo Cliente (relatorio_processos.py) ---
# grupos do filtro "Grupo Cliente", separados por "|" (ou "todos")
PROCESSOS_GRUPOS=3A FRIOS
# pasta dos .txt/.json (vazio = <SAIDA_PASTA>/relatorios); cada execução cria a subpasta do dia
RELATORIO_PASTA=
# true = abre a ficha de cada processo (só leitura) para Cidade/UF, tarefas e comentários.
# Mais lento. false = só a lista (o mesmo que --sem-ficha): última movimentação e pendência
# ficam "não informado" no PDF.
PROCESSOS_FICHA=true
# true = também gera "SEM GRUPO CLIENTE" (processos fora de todos os grupos); só com --grupo todos
PROCESSOS_SEM_GRUPO=false
# true = inclui os processos encerrados, o mesmo que --encerrados (padrão: só os ativos).
# Faz uma segunda pesquisa por grupo: no VIOS "ativos" e "encerrados" juntos dão 0 processos.
PROCESSOS_ENCERRADOS=false

# --- Execução ---
# pasta própria para não misturar com os dados do robô de intimações (saida/)
SAIDA_PASTA=saida_usuario2
HEADLESS=false
TIMEOUT=20
# true = navegador continua aberto quando o bot termina (útil para mapear a tela nova)
MANTER_ABERTO=true

# --- Relatório para o cliente (relatorio_cliente.py) ---
# Lê os <GRUPO>.json do dia e grava "<GRUPO>.pdf" na mesma pasta (14 campos por processo).
# true = a IA escreve resumo, pendência e financeira (o mesmo que rodar com --ia).
# false (padrão) = sem IA: textos montados do cadastro, nada é enviado e não há gasto.
RELATORIO_IA=false
# Com IA: os dados dos processos (já sem links, senhas e nomes da equipe) vão para a API do provedor.
# Uma chamada a cada 25 processos do grupo; falha da IA = grupo sai sem IA (aviso no PDF).
# openai ou anthropic (preencha só a chave do provedor escolhido)
LLM_PROVEDOR=openai
# vazio = padrão do provedor (openai: gpt-5.6 / anthropic: claude-opus-5-5)
LLM_MODELO=
# esforço de raciocínio: low, medium, high (texto simples: low basta)
LLM_ESFORCO=low
# teto de gasto com a IA por execução, em US$ (vazio ou 0 = sem teto); passou, o resto sai sem IA
LLM_LIMITE_US=
# preços (US$ por milhão de tokens, entrada/saída) para corrigir a tabela do bot/custo.py (vazio = tabela)
LLM_PRECOS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# arquivo com outro prompt para a IA (vazio = texto padrão do bot/campos_relatorio.py; aceita ~/...)
RELATORIO_CLIENTE_PROMPT=
